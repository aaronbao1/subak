                      }
                    ],
                    "title": "Amount"
                  },
                  "from_team": {
                    "title": "From Team",
                    "type": "string"
                  },
                  "to_team": {
                    "title": "To Team",
                    "type": "string"
                  }
                },
                "required": [
                  "from_team",
                  "to_team",
                  "amount"
                ],
                "title": "TransferLineIn",
                "type": "object"
              }
            },
            "additionalProperties": false,
            "properties": {
              "action_type": {
                "const": "transfer",
                "title": "Action Type",
                "type": "string"
              },
              "base_version": {
                "title": "Base Version",
                "type": "integer"
              },
              "envelope_increase": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },

    {
      "description": "Draft an allocation proposal for finance review: action_type `addition` (new money enters the envelope) or `transfer` (existing money moves between teams; envelope unchanged). The backend computes before/after and validates arithmetic. Each evidence_refs item is {kind: signal|document|forecast_snapshot|spend_summary, id, version?, note?}; a spend_summary ref uses the period id (e.g. 2026-P1) as its id. The result is pending_review and is NOT applied; only a finance approver can apply it.",
      "input_schema": {
        "discriminator": {
          "propertyName": "action_type"
        },
        "oneOf": [
          {
            "$defs": {
              "AdditionLineIn": {
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "type": "string"
                      }
                    ],
                    "title": "Amount"
                  },
                  "to_team": {
                    "title": "To Team",
                    "type": "string"
                  }
                },
                "required": [
                  "to_team",
                  "amount"
                ],
                "title": "AdditionLineIn",
                "type": "object"
              },
              "EvidenceRef": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Id",
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "signal",
                      "document",
                      "forecast_snapshot",
                      "spend_summary"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "note": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "type": "string"
                      },
                      {
                        "type": "null"

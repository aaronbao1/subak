                    ],
                    "default": null,
                    "title": "Note"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Version"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "title": "EvidenceRef",
                "type": "object"
              }
            },
            "additionalProperties": false,
            "properties": {
              "action_type": {
                "const": "addition",
                "title": "Action Type",
                "type": "string"
              },
              "base_version": {
                "title": "Base Version",
                "type": "integer"
              },
              "envelope_increase": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                    "type": "string"
                  }
                ],
                "title": "Envelope Increase"
              },
              "evidence_refs": {
                "items": {
                  "$ref": "#/$defs/EvidenceRef"
                },
                "maxItems": 100,
                "title": "Evidence Refs",
                "type": "array"
              },
              "lines": {
                "items": {
                  "$ref": "#/$defs/AdditionLineIn"
                },
                "maxItems": 100,
                "title": "Lines",
                "type": "array"
              },
              "period": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Period"
              },
              "rationale": {
                "maxLength": 10000,
                "title": "Rationale",
                "type": "string"
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Unit"
              }
            },
            "required": [
              "base_version",
              "rationale",
              "action_type",
              "envelope_increase",
              "lines"
            ],
            "title": "AdditionCreate",
            "type": "object"
          },
          {
            "$defs": {
              "EvidenceRef": {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maxLength": 200,
                    "minLength": 1,
                    "title": "Id",
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "signal",
                      "document",
                      "forecast_snapshot",
                      "spend_summary"
                    ],
                    "title": "Kind",
                    "type": "string"
                  },
                  "note": {
                    "anyOf": [
                      {
                        "maxLength": 1000,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Note"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Version"
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "title": "EvidenceRef",
                "type": "object"
              },
              "TransferLineIn": {
                "additionalProperties": false,
                "properties": {
                  "amount": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"

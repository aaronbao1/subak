      "kind": "draft",
      "name": "draft_proposal"
    },
    {
      "description": "Recover a stale proposal (finance's approval was refused with 409 stale_proposal because the budget moved after it was drafted). Re-drafts the SAME lines against the current budget as a NEW pending_review proposal that needs its own fresh review; the original is never applied and stays `stale`. The result has `stale_context` (the original's base version and figures, the current version and figures, per-team changes since, and the decisions that moved the budget) and `proposal` (the new draft with before/after). If the same intent no longer fits the current budget it is refused with the validation reasons and nothing is created; draft a fresh proposal instead. `rationale` is an optional note (what changed, why rebase) placed before the original rationale. Changes no allocation. Only the proposal this run was asked to recover may be rebased; any other id is refused with rebase_not_permitted.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "proposal_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Proposal Id",
            "type": "string"
          },
          "rationale": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rationale"
          }
        },
        "required": [
          "proposal_id"
        ],
        "title": "RebaseProposalIn",
        "type": "object"
      },
      "kind": "draft",
      "name": "rebase_proposal"
    }
  ]

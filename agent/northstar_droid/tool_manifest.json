              },
              "evidence_refs": {
                "items": {
                  "$ref": "#/$defs/EvidenceRef"
                },
                "maxItems": 100,
                "title": "Evidence Refs",
                "type": "array"
              },
              "lines": {
                "items": {
                  "$ref": "#/$defs/TransferLineIn"
